{
  "rules": {
    ".read": false,
    ".write": false,
    "tournaments": {
      "$tid": {
        ".read": false,
        ".write": false,
        "members": {
          ".read": false,
          ".write": false,
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": false,
            ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'editor' || newData.val() === 'viewer')"
          }
        },
        "matches": {
          ".read": "auth != null && (root.child('tournaments').child($tid).child('members').child(auth.uid).val() === 'admin' || root.child('tournaments').child($tid).child('members').child(auth.uid).val() === 'editor' || root.child('tournaments').child($tid).child('members').child(auth.uid).val() === 'viewer')",
          ".write": false,
          "$mid": {
            ".write": "auth != null && (root.child('tournaments').child($tid).child('members').child(auth.uid).val() === 'admin' || root.child('tournaments').child($tid).child('members').child(auth.uid).val() === 'editor') && data.exists() && newData.exists() && data.child('status').val() === 'playing' && newData.child('status').val() === 'playing' && newData.child('version').isNumber() && newData.child('version').val() === data.child('version').val() + 1 && newData.child('updatedBy').val() === auth.uid && newData.child('lastEventId').isString() && newData.child('lastEventId').val() !== data.child('lastEventId').val()",
            ".validate": "newData.hasChildren(['version','status','sets','updatedBy','lastEventId','lastEventFingerprint']) && newData.childrenCount() === 6",
            "version": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "status": {
              ".validate": "newData.isString() && newData.val() === 'playing'"
            },
            "sets": {
              ".validate": "newData.hasChildren() && newData.childrenCount() <= 5",
              "$set": {
                ".validate": "$set.matches(/^[0-4]$/) && newData.hasChildren(['a','b']) && newData.childrenCount() === 2",
                "a": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99 && newData.val() % 1 === 0"
                },
                "b": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99 && newData.val() % 1 === 0"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "updatedBy": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "lastEventId": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$/)"
            },
            "lastEventFingerprint": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "tables": {
          ".read": "auth != null && (root.child('tournaments').child($tid).child('members').child(auth.uid).val() === 'admin' || root.child('tournaments').child($tid).child('members').child(auth.uid).val() === 'editor' || root.child('tournaments').child($tid).child('members').child(auth.uid).val() === 'viewer')",
          ".write": false
        }
      }
    }
  }
}
